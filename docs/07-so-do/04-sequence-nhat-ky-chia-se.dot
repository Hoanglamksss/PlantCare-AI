p4_1 -> p4_2 [label="5. Tạo reservation ảnh pending_delete\nThời hạn 2 phút", color="#285e93", fontcolor="#285e93", fontsize=15, penwidth=1.5,  arrowsize=0.85];
p5_1 -> p5_3 [label="6. Lưu ảnh qua dịch vụ Media\nĐặt thời hạn reservation", color="#285e93", fontcolor="#285e93", fontsize=15, penwidth=1.5,  arrowsize=0.85];
p6_1 -> p6_2 [label="7. Một giao dịch kích hoạt ảnh\nvà thêm care_logs + care_log_photos", color="#285e93", fontcolor="#285e93", fontsize=15, penwidth=1.5,  arrowsize=0.85];
p7_1 -> p7_0 [label="8. 201, nhật ký và URL ảnh chính chủ", color="#207054", fontcolor="#207054", fontsize=15, penwidth=1.5, style=dashed, arrowsize=0.85];
p8_0 -> p8_1 [label="9. PUT /plants/{id}/share\nshared=true, title, includeHistory", color="#285e93", fontcolor="#285e93", fontsize=15, penwidth=1.5,  arrowsize=0.85];
p9_1 -> p9_2 [label="10. Khóa cây, ghi quyền chia sẻ\nĐồng bộ community_posts bằng trigger", color="#285e93", fontcolor="#285e93", fontsize=15, penwidth=1.5,  arrowsize=0.85];
p10_1 -> p10_0 [label="11. 200, trạng thái quyền chia sẻ", color="#207054", fontcolor="#207054", fontsize=15, penwidth=1.5, style=dashed, arrowsize=0.85];
p11_0 -> p11_1 [label="12. Thu hồi bằng shared=false", color="#285e93", fontcolor="#285e93", fontsize=15, penwidth=1.5,  arrowsize=0.85];
p12_1 -> p12_2 [label="13. Đặt da_chia_se=false\nvà chia_se_nhat_ky=false", color="#285e93", fontcolor="#285e93", fontsize=15, penwidth=1.5,  arrowsize=0.85];
p13_1 -> p13_0 [label="14. 200, đã thu hồi chia sẻ", color="#207054", fontcolor="#207054", fontsize=15, penwidth=1.5, style=dashed, arrowsize=0.85];
