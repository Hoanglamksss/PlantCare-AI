p0_0 -> p0_1 [label="1. POST /plants/{id}/notes\nNội dung, thời gian và tối đa 4 ảnh", color="#285e93", fontcolor="#285e93", fontsize=15, penwidth=1.5,  arrowsize=0.85];
p1_1 -> p1_2 [label="2. Kiểm tra chủ cây và tài khoản\nCho phép cây đang theo dõi hoặc lưu trữ", color="#285e93", fontcolor="#285e93", fontsize=15, penwidth=1.5,  arrowsize=0.85];
p2_1 -> p2_4 [label="3. Chuẩn hóa từng ảnh, bỏ metadata", color="#285e93", fontcolor="#285e93", fontsize=15, penwidth=1.5,  arrowsize=0.85];
