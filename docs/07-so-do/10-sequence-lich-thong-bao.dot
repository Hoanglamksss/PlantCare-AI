p5_3 -> p5_2 [label="6. Khóa lịch, kiểm tra lại tài khoản\nvà cây chưa lưu trữ", color="#285e93", fontcolor="#285e93", fontsize=15, penwidth=1.5,  arrowsize=0.85];
p6_3 -> p6_2 [label="7. Một giao dịch thêm notifications\nvà tính lần đến hạn tiếp theo", color="#285e93", fontcolor="#285e93", fontsize=15, penwidth=1.5,  arrowsize=0.85];
p7_2 -> p7_3 [label="8. Commit, UNIQUE (lịch, giờ hẹn)\ngiữ thông báo không trùng", color="#207054", fontcolor="#207054", fontsize=15, penwidth=1.5, style=dashed, arrowsize=0.85];
p8_0 -> p8_1 [label="9. GET /notifications\nKhi mở chuông hoặc polling", color="#285e93", fontcolor="#285e93", fontsize=15, penwidth=1.5,  arrowsize=0.85];
p9_1 -> p9_2 [label="10. Đọc thông báo của chủ\nvà đếm số chưa đọc", color="#285e93", fontcolor="#285e93", fontsize=15, penwidth=1.5,  arrowsize=0.85];
