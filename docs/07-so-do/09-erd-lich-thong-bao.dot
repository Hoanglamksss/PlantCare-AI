admin_audit_logs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BORDER="1"><FONT POINT-SIZE="15"><B>admin_audit_logs</B></FONT></TD></TR><TR><TD ALIGN="LEFT">nguoi_thuc_hien_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">FK, ?</TD></TR>
