digraph ERD {
    graph [rankdir=LR, bgcolor="white", pad=0.5, nodesep=0.65, ranksep=1.5, splines=polyline,
      fontname="Arial", fontsize=25, labelloc=t, label="PlantCare AI 0.5 — ERD lịch chăm sóc và thông báo\nDữ liệu máy chủ thuộc từng tài khoản"];
    node [shape=plain, fontname="Arial", fontsize=12, fontcolor="black"];
    edge [dir=forward, arrowhead=normal, arrowsize=0.65, color="black", fontname="Arial", fontsize=12];
    accounts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BORDER="1"><FONT POINT-SIZE="15"><B>accounts</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT">PK</TD></TR>
