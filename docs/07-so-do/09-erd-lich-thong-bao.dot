<TR><TD ALIGN="LEFT">doi_tuong_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT"></TD></TR>
<TR><TD ALIGN="LEFT">xay_ra_luc</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
    accounts -> admin_audit_logs [label="0..1 : 0..N"];
accounts -> care_schedules [label="1 : 0..N"];
accounts -> notifications [label="1 : 0..N"];
accounts -> sessions [label="1 : 0..N"];
accounts -> user_plants [label="1 : 0..N"];
care_schedules -> notifications [label="1 : 0..N"];
user_plants -> care_schedules [label="1 : 0..N"];
user_plants -> notifications [label="1 : 0..N"];
    legend [shape=plaintext, fontsize=14, label="PK = khóa chính · FK = khóa ngoại · UQ = duy nhất · UQ* = tham gia khóa duy nhất ghép · ? = được rỗng\nKhóa ghép được gom thành quan hệ giữa bảng. Mũi tên từ bảng được tham chiếu tới bảng giữ FK.\nCardinality thể hiện khả năng schema; API tạo chẩn đoán và job cùng giao dịch.\nclient_id duy nhất theo tài khoản giúp nhập lịch trình duyệt an toàn.\nUNIQUE (lich_id, hen_luc) chống trùng. Xóa lịch dừng nhắc mới, giữ lịch sử thông báo.\nWorker chỉ nhắc tài khoản hoạt động và cây chưa lưu trữ. Múi giờ Asia/Ho_Chi_Minh (UTC+7)."];
  }
