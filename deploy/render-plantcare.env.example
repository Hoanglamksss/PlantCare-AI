# Render backend — configuration for plantcare.io.vn.
# Copy values individually to Render after verifying the domain. Keep existing database and CSRF secrets.
APP_ORIGIN=https://www.plantcare.io.vn
APP_ADDITIONAL_ORIGINS=https://plant-care-ai-sigma.vercel.app
HOST=0.0.0.0
COOKIE_SECURE=true

# Optional: enable after mail.plantcare.io.vn is Verified in Resend.
# To keep Gmail active, leave the existing Gmail configuration in place.
# OTP_EMAIL_PROVIDER=resend
# OTP_EMAIL_FROM=PlantCare <otp@mail.plantcare.io.vn>
# RESEND_API_KEY=<set in Render Environment; never commit>
