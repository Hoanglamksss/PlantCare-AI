upstream plantcare_backend {
    zone plantcare_backend 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server backend:3000 resolve;
    keepalive 8;
}

server {
    listen 8080;
    server_name _;
    access_log off;
    location = /health/ready { proxy_pass http://plantcare_backend; }
    location / { return 404; }
}

server {
    listen 8443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 8443 ssl;
    server_name ${APP_DOMAIN};
    ssl_certificate /run/secrets/origin_cert;
    ssl_certificate_key /run/secrets/origin_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    # Trust this header only when the TCP peer is a Cloudflare edge.
    # Keep ranges current from https://www.cloudflare.com/ips/.
    real_ip_header CF-Connecting-IP;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    root /usr/share/nginx/html;
    server_tokens off;
    access_log off;
    client_max_body_size 9m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;

    proxy_http_version 1.1;
    proxy_set_header Host ${APP_DOMAIN};
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host ${APP_DOMAIN};
    proxy_set_header X-Forwarded-Port "";
    proxy_set_header Forwarded "";

    location ~ ^/(api(?:/|$)|health(?:/|$)) {
        proxy_read_timeout 90s;
        proxy_pass http://plantcare_backend;
    }
    location ~ ^/(docs(?:/|$)|openapi\.json$) { return 404; }
    location /assets/ { try_files $uri =404; expires 1y; }
    location / { try_files $uri $uri/ /index.html; expires -1; }
}
